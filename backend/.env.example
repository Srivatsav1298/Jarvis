# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME=IronmanJARVIS
APP_VERSION=0.1.0
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api/v1

# Database (SQLite now; swap to postgresql+asyncpg://... later)
DATABASE_URL=sqlite+aiosqlite:///./data/jarvis.db
DATABASE_ECHO=false

# CORS (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# AI provider (placeholders — no AI logic yet)
AI_PROVIDER=ollama
AI_MODEL=llama3.2
AI_API_KEY=
AI_ENABLE_LIVE_TOOLS=true
AI_TOOL_CALL_LIMIT=4
AI_TOOL_TIMEOUT_SECONDS=12

# Voice (kokoro = local neural British TTS via .kokoro-venv worker;
#         kokoro-api = container-backed OpenAI-compatible gateway, port 8880)
VOICE_ENABLED=false
VOICE_STT_ENGINE=
VOICE_TTS_ENGINE=kokoro
VOICE_TTS_VOICE=en-GB
VOICE_WAKE_PHRASE=Hey Starc
VOICE_KOKORO_MODEL_PATH=voice_assets/kokoro-v1.0.onnx
VOICE_KOKORO_VOICES_PATH=voice_assets/voices-v1.0.bin
VOICE_KOKORO_PYTHON_PATH=.kokoro-venv/bin/python
VOICE_KOKORO_VOICE=bf_emma
VOICE_KOKORO_LANG=en-gb

# Kokoro container TTS (self-hosted, OpenAI-compatible)
KOKORO_API_URL=http://localhost:8880/v1
KOKORO_API_KEY=
JARVIS_VOICE_MODEL=af_heart
